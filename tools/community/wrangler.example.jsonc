{
  "name": "westcreeper-community",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./admin",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://westcreeper.com,https://www.westcreeper.com,https://westcreeper.github.io",
    "TURNSTILE_HOSTNAMES": "westcreeper.com,www.westcreeper.com,westcreeper.github.io",
    "ACCESS_TEAM": "",
    "ACCESS_AUD": "",
    "ADMIN_EMAILS": "",
    "SUBMISSIONS_ENABLED": "true",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "westcreeper-community",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations",
    },
  ],
  "ratelimits": [
    {
      "name": "POST_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
}
