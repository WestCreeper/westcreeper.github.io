source "https://rubygems.org"

# Standalone blog dependencies; no packaged TeXt theme is required.
gem "jekyll", "~> 4.4"
gem "jekyll-feed", "~> 0.17"
gem "jekyll-sitemap", "~> 1.4"
gem "jemoji", "~> 0.13"

# Time-zone data is not provided by Windows itself.
gem "tzinfo-data", platforms: [:mingw, :x64_mingw, :mswin]
